# Convex (filled automatically by `npx convex dev`)
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# HTTP-actions origin (`.site` twin of the API origin locally). Also feeds the
# Content-Security-Policy in next.config.ts, which Next bakes in at BUILD time.
NEXT_PUBLIC_CONVEX_SITE_URL=

# --- The variables below are set on the CONVEX DEPLOYMENT, not in this file:
#     npx convex env set NAME value
# They are listed here so you know the full inventory (see README §Google setup
# and §Go-live checklist).
#
# SITE_URL=http://localhost:3000        # where the app runs (redirect target)
# JWT_PRIVATE_KEY=...                   # Convex Auth signing key — generated by
#                                       # `node scripts/setup-auth.mjs` (README
#                                       # §Quickstart step 2; pilot: §Deploying with Docker)
# JWKS=...                              # Convex Auth public key set (same script)
# AUTH_GOOGLE_ID=                       # OAuth client id — Google sign-in
# AUTH_GOOGLE_SECRET=
# GOOGLE_DRIVE_CLIENT_ID=               # may reuse the same OAuth client
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_PICKER_API_KEY=                # server-side Picker/Drive API key
#
# --- Sign-up gate (convex/auth.ts). It fails CLOSED: a real deployment is
#     invite-only unless you explicitly open it. Precedence:
#       1. INVITE_ONLY_SIGNUPS=1  — explicit lock, wins over everything
#       2. ALLOW_OPEN_SIGNUPS=1   — deliberate escape hatch, open registration
#       3. otherwise invite-only, except on a local dev backend (CONVEX_SITE_URL
#          on 127.0.0.1/localhost/[::1]), which stays open so `pnpm dev` and the
#          Playwright suite need zero configuration.
#     SET INVITE_ONLY_SIGNUPS=1 ON THE PILOT BACKEND — do not rely on the default.
#
# INVITE_ONLY_SIGNUPS=1
# ALLOW_OPEN_SIGNUPS=                   # leave unset in the pilot
# ALLOW_PASSWORD_SIGNUPS=               # local only by default; 1 explicitly enables unverified password registration on remote deployments (not recommended)
# ADMIN_SIGNUP_ALLOWLIST=you@studio.com # comma-separated; bootstraps the first
#                                       # owner before any invite exists

# (No browser-side Google vars: the Picker receives its apiKey, appId and a
#  short-lived access token from drive.getPickerConfig at runtime.)

# --- Docker deployment (docker-compose.yml). Set in the host's deploy
#     environment — a `.env` next to docker-compose.yml on the server, or
#     Dokploy's Environment tab if Dokploy is the deployer — NOT in this file.
#     Build args are inlined at build time → rebuild to change.
#
# NEXT_PUBLIC_CONVEX_URL=https://api.kinolab.ai       # build arg + runtime
# NEXT_PUBLIC_CONVEX_SITE_URL=https://actions.kinolab.ai
# NEXT_PUBLIC_DEPLOYMENT_URL=                          # fallback for both origins
# CONVEX_SELF_HOSTED_URL=https://api.kinolab.ai        # convex-deploy push target
# CONVEX_SELF_HOSTED_ADMIN_KEY=                        # never commit — generate_admin_key.sh
# ALLOWED_HOSTS=pilot.kinolab.ai       # hosts allowed into redirect URLs (middleware.ts)
# FORCE_HTTPS=1                        # behind a TLS-terminating proxy
# TRAEFIK_ENTRYPOINT=web               # frontend compose only; inert under Caddy
# TRAEFIK_TLS=false                    # `1` together with a websecure entrypoint
# CSP_EXTRA_ORIGINS=                   # comma-separated extra CSP origins
# CSP_REPORT_ONLY=                     # `1` = ship the CSP report-only

# --- Self-hosted Convex backend (deploy/convex-backend.compose.yml → deploy/.env,
#     gitignored; commented template with every variable:
#     deploy/convex-backend.env.example). The backend container is STATELESS —
#     documents in Postgres, blobs in MinIO — and `up` refuses to start unless
#     every required value below is present and non-empty. FILL deploy/.env IN
#     BEFORE THE FIRST `up`: the first boot pins the storage type (S3/local)
#     into the database permanently (README §The backend holds nothing).
#
# INSTANCE_NAME=kinolab                # REQUIRED
# INSTANCE_SECRET=                     # REQUIRED; generate once, NEVER change — the admin key derives from it
# CONVEX_CLOUD_ORIGIN=https://api.kinolab.ai           # REQUIRED
# CONVEX_SITE_ORIGIN=https://actions.kinolab.ai        # REQUIRED
# NEXT_PUBLIC_DEPLOYMENT_URL=https://api.kinolab.ai    # REQUIRED; dashboard → backend
# CONVEX_IMAGE_TAG=                    # pinned backend/dashboard build (README §Upgrading)
# POSTGRES_PASSWORD=                   # REQUIRED; URL-safe chars only (POSTGRES_USER defaults to convex)
# KINOLAB_S3_ACCESS_KEY=               # REQUIRED; MinIO user scoped to the kinolab-* buckets
# KINOLAB_S3_SECRET_KEY=               # REQUIRED  (project-prefixed: a shell AWS_* export must not override .env)
# KINOLAB_S3_ENDPOINT=http://host.docker.internal:9000  # MinIO on the same host
# S3_STORAGE_FILES_BUCKET=kinolab-files                # + _MODULES/_SEARCH/_EXPORTS/_SNAPSHOT_IMPORTS
# CONVEX_SELF_HOSTED_ADMIN_KEY=""      # nightly backup service; quote it — contains '|'
# BACKUP_DIR=/var/backups/kinolab      # host directory for the nightly exports (absolute, outside the checkout)
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_KEEP_DAYS=14
# OFFSITE_S3_ENDPOINT=                 # any S3-compatible bucket OFF the host (e.g. Cloudflare R2);
# OFFSITE_ACCESS_KEY_ID=               # all four empty = "NO OFFSITE COPY IS BEING MADE"
# OFFSITE_SECRET_ACCESS_KEY=
# OFFSITE_BUCKET=
# OFFSITE_INTERVAL_SECONDS=900
# KINOLAB_API_PORT=3230                # loopback port for the host-level Caddy: api → 3210
# KINOLAB_SITE_PORT=3231               #                                    actions → 3211
