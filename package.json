{
  "name": "kinolab",
  "version": "1.6.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "concurrently -k -n convex,next -c blue,green \"convex dev\" \"next dev\"",
    "dev:frontend": "next dev",
    "dev:backend": "convex dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test e2e/unit/*.test.mjs",
    "test:api": "node e2e/api/run.mjs",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test:unit && pnpm audit && pnpm build"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@base-ui/react": "^1.7.0",
    "@convex-dev/auth": "^0.0.95",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.44.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^1.31.0",
    "next": "^15.5.25",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "shadcn": "^4.18.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^10.0.5",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0"
  }
}
