# deploy/convex-backend.env.example — template for deploy/.env (gitignored:
# the repo's .gitignore lists `.env`, which matches at every depth).
#
# On the server:  cp deploy/convex-backend.env.example deploy/.env  and fill
# it in BEFORE the first `docker compose -f deploy/convex-backend.compose.yml up`.
# Every value below is a PLACEHOLDER — never commit the real file.
#
# !!! COMPLETE THIS FILE BEFORE THE FIRST `up` !!!
# The backend's first boot against an empty database writes the storage type
# (S3 vs local) into the database PERMANENTLY. The compose guards every
# required value with ${VAR:?} so an incomplete file aborts `up` instead of
# booting a backend on local storage — but the guards only see this file:
# a wrong endpoint or a wrong key boots fine and pins S3 anyway (that is the
# good case; MinIO problems are fixable later, the storage TYPE is not). After
# `up`, prove the mode (README §Rebuild: fresh server):
#   docker compose -f deploy/convex-backend.compose.yml exec kinolab-convex-backend \
#     sh -c "tr '\0' '\n' </proc/1/cmdline | grep -E -- '--(s3|local)-storage|--db'"
# → `--s3-storage`. If it says `--local-storage`: `down -v` (empty DB only),
# fix, `up -d`, check again. Choosing S3 prints nothing in the log.
#
# The required values are deliberately EMPTY here, so a copied-but-unedited
# file cannot start anything (an all-zeros INSTANCE_SECRET would be a
# guessable admin key on a public hostname).
#
# KEEP IN A PASSWORD MANAGER, TOGETHER:
#   • this file (INSTANCE_SECRET, POSTGRES_PASSWORD, the MinIO keys)
#   • the admin key (CONVEX_SELF_HOSTED_ADMIN_KEY)
#   • a fresh `scripts/pilot-env-backup.sh` dump — the Convex DEPLOYMENT's own
#     variables (JWT_PRIVATE_KEY, JWKS, SITE_URL, ADMIN_SIGNUP_ALLOWLIST,
#     INVITE_ONLY_SIGNUPS, NEXT_PUBLIC_GOOGLE_API_KEY, NEXT_PUBLIC_GOOGLE_APP_ID,
#     the AUTH_GOOGLE_* / GOOGLE_DRIVE_* / GOOGLE_PICKER_API_KEY secrets) live
#     inside the backend, NOT in this file, NOT in the repo and NOT in an
#     export zip. scripts/pilot-rebuild.sh replays that dump into a fresh
#     backend (README §Rebuild).
#
# Quoting: compose strips matching double or single quotes. A value that
# contains `$` must be single-quoted or compose interpolates it; a value
# that contains `|` (the admin key) must be quoted if you ever `source` this
# file in a shell. Lines starting with `#` are comments; commented-out
# variables show the compose default.
#
# Precedence trap: compose lets a variable exported in YOUR SHELL override
# this file. That is why the MinIO keys are named KINOLAB_S3_* here and not
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY (an aws CLI session with the
# offsite bucket's keys exported would otherwise boot the backend with them).
# Before `up`: `env | grep -E '^(INSTANCE_|POSTGRES_|KINOLAB_|CONVEX_)'` must
# print nothing.

# ---------------------------------------------------------------- instance
# Both REQUIRED — `up` aborts without them.
INSTANCE_NAME=kinolab
# Generate once (`openssl rand -hex 32`) and NEVER change it: the admin key
# is derived from INSTANCE_NAME + INSTANCE_SECRET, so a new secret silently
# invalidates every stored admin key — the frontend project's
# CONVEX_SELF_HOSTED_ADMIN_KEY, the backup service's, .env.pilot.local. A
# backend rebuilt with the SAME secret produces the SAME key. Left empty, the
# image would mint a random secret on every container start (no volume).
INSTANCE_SECRET=

# ---------------------------------------------------------------- origins
# REQUIRED. Public origins terminated by Caddy (behind Cloudflare).
# CONVEX_SITE_URL, the variable Convex functions see, is derived by the
# backend from CONVEX_SITE_ORIGIN — never set it by hand.
CONVEX_CLOUD_ORIGIN=https://api.kinolab.ai
CONVEX_SITE_ORIGIN=https://actions.kinolab.ai
# REQUIRED. Dashboard → backend: the browser on the SSH tunnel talks to this
# URL. The only variable the dashboard container receives.
NEXT_PUBLIC_DEPLOYMENT_URL=https://api.kinolab.ai

# ---------------------------------------------------------------- image tag
# One immutable commit-sha tag for BOTH the backend and the dashboard image.
# Bumping it is an upgrade (README §Upgrading the self-hosted backend): export
# first. Newest stable at the time of writing (2026-09-18):
# cf8398b4719cc7c32454229ccad52922398b7d67.
# CONVEX_IMAGE_TAG=c0cb7ae17f54e14846c243c5332a8a5e6d0e19d4

# ---------------------------------------------------------------- Postgres
# The database name is INSTANCE_NAME (POSTGRES_DB in the compose) — the
# backend derives it from the instance name and POSTGRES_URL carries none.
# POSTGRES_USER=convex
# REQUIRED — `up` aborts without it. URL-safe characters only
# (`openssl rand -hex 24`): the value is pasted into POSTGRES_URL unencoded,
# so `@ : / % # ?` would corrupt the URL. Applied when the kinolab-pgdata
# volume is first initialised; to rotate later run `ALTER USER convex
# PASSWORD '…'` inside kinolab-postgres, then change it here.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- MinIO / S3
# MinIO runs on this host OUTSIDE this compose project (API :9000, console
# :9001). From inside a container the host is host.docker.internal
# (extra_hosts host-gateway); the host's own name does not resolve there.
# Alternative: http://<LAN IP>:9000.
# KINOLAB_S3_ENDPOINT=http://host.docker.internal:9000
# KINOLAB_S3_REGION=us-east-1
# REQUIRED — `up` aborts without them. The MinIO user whose policy is scoped
# to the five buckets below ("kino" today). Mapped to AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY inside the backend container only.
KINOLAB_S3_ACCESS_KEY=
KINOLAB_S3_SECRET_KEY=
# Buckets — must exist before `up` (they do on the pilot host; files has
# versioning on, no object lock). Defaults match the existing bucket names.
# S3_STORAGE_FILES_BUCKET=kinolab-files
# S3_STORAGE_MODULES_BUCKET=kinolab-modules
# S3_STORAGE_SEARCH_BUCKET=kinolab-search
# S3_STORAGE_EXPORTS_BUCKET=kinolab-exports
# S3_STORAGE_SNAPSHOT_IMPORTS_BUCKET=kinolab-snapshot-imports
# Fixed in the compose, listed so nobody re-adds them here: AWS_REGION and
# the five bucket variables are always passed (that is what selects
# --s3-storage), path-style and no-SSE are ON (AWS_S3_FORCE_PATH_STYLE=true,
# AWS_S3_DISABLE_SSE=true — the literal string true; "1" is silently false).
# Do NOT set AWS_S3_DISABLE_CHECKSUMS: trailing checksums work against this
# MinIO.

# ---------------------------------------------------------------- backup
# Nightly `npx convex export --include-file-storage` (service
# kinolab-convex-backup). Admin key — after the first `up`:
#   docker compose -f deploy/convex-backend.compose.yml exec kinolab-convex-backend ./generate_admin_key.sh
# It looks like `kinolab|<hex>` — keep the quotes. Without it the service
# logs "NO BACKUP IS BEING TAKEN" and waits (so `up` works before the key
# exists; fill it in and `up -d` again).
CONVEX_SELF_HOSTED_ADMIN_KEY=""
# Host directory the zips land in (bind mount). Absolute, OUTSIDE the git
# checkout — a relative path resolves against deploy/ inside the checkout,
# where the zips are not gitignored. Docker creates it on first `up`.
# BACKUP_DIR=/var/backups/kinolab
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_KEEP_DAYS=14

# ---------------------------------------------------------------- offsite
# Service kinolab-offsite mirrors BACKUP_DIR (→ <bucket>/backups/) and the
# files bucket (→ <bucket>/files/) to any S3-compatible bucket OFF this host
# with `mc mirror`. All four empty = it logs "NO OFFSITE COPY IS BEING MADE"
# and waits — that is the state until somebody fills these in. Example,
# Cloudflare R2 (S3 API token with object read+write on the one bucket):
#   OFFSITE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   OFFSITE_BUCKET=kinolab-offsite
OFFSITE_S3_ENDPOINT=
OFFSITE_ACCESS_KEY_ID=
OFFSITE_SECRET_ACCESS_KEY=
OFFSITE_BUCKET=
# OFFSITE_INTERVAL_SECONDS=900
# mc image tag on quay.io/minio/mc (pinned in the compose; bump deliberately).
# MC_IMAGE_TAG=RELEASE.2025-08-13T08-35-41Z

# ---------------------------------------------------------------- ports
# Backend ports published on 127.0.0.1 for the host-level Caddy
# (api.kinolab.ai → 3210 via KINOLAB_API_PORT, actions.kinolab.ai → 3211 via
# KINOLAB_SITE_PORT). 3230/3231 because another Convex backend on the same
# host may hold 3210/3211. The backend joins no external network; a Traefik
# host adds labels via a compose override (compose header).
# KINOLAB_API_PORT=3230
# KINOLAB_SITE_PORT=3231

# ---------------------------------------------------------------- optional
# Passed to the backend only when non-empty (run_backend.sh).
# DISABLE_BEACON=1            # stop the anonymous usage beacon
# REDACT_LOGS_TO_CLIENT=1     # hide server error details from clients
